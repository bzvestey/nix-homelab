+func TestJujutsuChangeIDCommitSignedBySSH(t *testing.T) {
+	// Generated by Jujutsu with git.write-change-id-header=true and a disposable
+	// Ed25519 key. The encoded commit contains the public signature, not the key.
+	const encodedCommit = ""
+	const allowedSigner = "comin-jj-fixture@example.invalid ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAMvzt7vMXn/BUnkPYuxEljFWdx2mXqobPbrxGzeOg8/"
+
+	rawCommit, err := base64.StdEncoding.DecodeString(encodedCommit)
+	assert.NoError(t, err)
+	repository, err := git.PlainInit(t.TempDir(), true)
+	assert.NoError(t, err)
+	encoded := &plumbing.MemoryObject{}
+	encoded.SetType(plumbing.CommitObject)
+	writer, err := encoded.Writer()
+	assert.NoError(t, err)
+	_, err = writer.Write(rawCommit)
+	assert.NoError(t, err)
+	assert.NoError(t, writer.Close())
+	commitID, err := repository.Storer.SetEncodedObject(encoded)
+	assert.NoError(t, err)
+	assert.Equal(t, "5b9c370a678f1f780637c16a4eacf5157d3c710f", commitID.String())
+
+	signers, err := parseSSHAllowedSigners(allowedSigner)
+	assert.NoError(t, err)
+	signedBy, err := commitSignedBySSH(repository, commitID.String(), signers)
+	assert.NoError(t, err)
+	assert.Equal(t, "comin-jj-fixture@example.invalid", signedBy)
+}
